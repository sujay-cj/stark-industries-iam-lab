# ============================================================
#  Stark Industries IAM Platform — Backend Environment Template
#  Copy this file to backend/.env and fill in your actual values.
#  NEVER commit the actual .env file to version control.
# ============================================================

# ------------------------------------------------------------
# Express Server
# ------------------------------------------------------------
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------
# Keycloak OIDC Configuration
# ------------------------------------------------------------
KEYCLOAK_REALM=stark-industries
KEYCLOAK_CLIENT_ID=soc-portal
KEYCLOAK_ISSUER=http://localhost:8080/realms/stark-industries

# ------------------------------------------------------------
# Splunk Enterprise REST API
# ------------------------------------------------------------
SPLUNK_HOST=https://localhost:8089
SPLUNK_PASSWORD=your_splunk_password

# ------------------------------------------------------------
# Google Gemini AI (JARVIS Copilot)
# Get your key from: https://aistudio.google.com
# ------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
