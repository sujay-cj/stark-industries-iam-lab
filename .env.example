# ============================================================
#  Stark Industries IAM Lab — Root Environment Template
#  Copy this file to .env and fill in your actual values.
#  NEVER commit the actual .env file to version control.
# ============================================================

# ------------------------------------------------------------
# OpenLDAP (Docker Container)
# ------------------------------------------------------------
LDAP_ORGANISATION=Stark Industries
LDAP_DOMAIN=stark.lab
LDAP_ADMIN_PASSWORD=your_ldap_admin_password

# ------------------------------------------------------------
# PostgreSQL (Keycloak backing store — Docker Container)
# ------------------------------------------------------------
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=your_postgres_password

# ------------------------------------------------------------
# Keycloak Identity Provider (Docker Container)
# ------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your_keycloak_admin_password
KEYCLOAK_REALM=stark-industries

# ------------------------------------------------------------
# Splunk Enterprise REST API
# ------------------------------------------------------------
SPLUNK_HOST=https://localhost:8089
SPLUNK_PASSWORD=your_splunk_password

# ------------------------------------------------------------
# Google Gemini AI (JARVIS Copilot)
# Get your key from: https://aistudio.google.com
# ------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here